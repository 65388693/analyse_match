# Required: Football-Charts MCP key
FC_API_KEY=replace_with_your_football_charts_key

# Required for the global fixtures, live status and alerts
LIVE_FOOTBALL_KEY=replace_with_your_live_football_key

# Protect the public app with HTTP Basic Auth
APP_ENV=production
WEB_AUTH_USERNAME=choose_a_private_username
WEB_AUTH_PASSWORD=replace_with_a_long_random_password

# Optional
ODDS_API_KEY=
